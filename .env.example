# =============================================================================
# TG LAB — Variables de entorno
# =============================================================================
# Copia este archivo a `.env` y completa los valores.
# NUNCA subas `.env` al repositorio. Solo `.env.example` (sin secretos reales).
#
# Entornos:
#   - development : tu máquina local
#   - test        : ejecución de pruebas (usa .env.test si existe)
#   - production  : Vercel / servidor (se configura en el panel del proveedor)
# =============================================================================

# --- Aplicación --------------------------------------------------------------
# URL pública del sitio (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Entorno lógico de la app: development | test | production
APP_ENV="development"

# --- Base de datos (PostgreSQL) --------------------------------------------
# Local (opción recomendada para empezar): ejecuta `npm run dev:db` que levanta
# un PostgreSQL local vía Prisma y te entrega una URL `prisma+postgres://...`.
# Producción: cadena de conexión de tu Postgres administrado (Neon, Prisma
# Postgres, Supabase, etc.). Debe incluir `sslmode=require` en la nube.
DATABASE_URL="postgresql://usuario:password@localhost:5432/tglab?schema=public"

# --- Autenticación (Better Auth) ------------------------------------------
# Secreto para firmar sesiones/tokens. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="reemplazar-por-secreto-largo-aleatorio"
# URL base para callbacks de auth (normalmente igual a NEXT_PUBLIC_SITE_URL)
BETTER_AUTH_URL="http://localhost:3000"

# --- Almacenamiento de archivos (S3 compatible: Cloudflare R2) -------------
# Déjalo vacío en desarrollo para usar el almacenamiento local en /public/uploads.
# En producción usa Cloudflare R2 (S3-compatible, egress gratis).
STORAGE_DRIVER="local"                      # local | s3
S3_ENDPOINT=""                              # https://<accountid>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
# URL pública/CDN desde donde se sirven los archivos (dominio de R2 o CDN propio)
S3_PUBLIC_URL=""

# Límites de subida (bytes). Imagen 8 MB / Video 100 MB por defecto.
UPLOAD_MAX_IMAGE_BYTES="8388608"
UPLOAD_MAX_VIDEO_BYTES="104857600"

# --- Pagos: Mercado Pago — Checkout Pro (Chile) ------------------------------
# 1. Entra a https://www.mercadopago.cl/developers/panel -> "Tus integraciones"
# 2. Crea una aplicación (tipo "Pagos online" / Checkout Pro).
# 3. En "Credenciales de prueba" copia Access Token y Public Key (TEST-...).
#    En "Credenciales de producción" (APP_USR-...) cuando vayas a cobrar de verdad.
# 4. En "Webhooks" configura la URL:  {NEXT_PUBLIC_SITE_URL}/api/webhooks/mercadopago
#    y copia la "clave secreta" que MP genera -> MERCADOPAGO_WEBHOOK_SECRET.
# Mientras ACCESS_TOKEN o PUBLIC_KEY estén vacíos, el método NO aparece en el
# checkout y NO se simula ningún pago.
MERCADOPAGO_ACCESS_TOKEN=""                 # TEST-... (sandbox) | APP_USR-... (prod)
MERCADOPAGO_PUBLIC_KEY=""                   # TEST-... | APP_USR-...
MERCADOPAGO_WEBHOOK_SECRET=""               # firma de notificaciones (x-signature)
MERCADOPAGO_MODE="sandbox"                  # sandbox | production

# --- Pagos: Transferencia bancaria manual --------------------------------
# Si defines PAYMENTS_BANK_TRANSFER_ENABLED=true, el checkout ofrece transferencia.
# Los datos bancarios reales se cargan desde /admin/configuracion (no aquí).
PAYMENTS_BANK_TRANSFER_ENABLED="true"

# --- Pagos: Transbank Webpay Plus (fase 2, aún no activo) ----------------
# Deja vacío hasta tener la afiliación comercial aprobada.
TRANSBANK_COMMERCE_CODE=""
TRANSBANK_API_KEY=""
TRANSBANK_MODE="integration"               # integration | production

# --- Email transaccional (Resend) ---------------------------------------
# 1. Crea la cuenta en https://resend.com y genera una API key.
# 2. Verifica tu dominio (DNS) para poder enviar desde hola@tudominio.cl.
# Comportamiento según entorno:
#   - con RESEND_API_KEY          -> envía de verdad (Resend)
#   - sin clave y NODE_ENV=dev/test -> imprime el correo en la consola
#   - sin clave y NODE_ENV=production -> NO envía y registra el fallo (no finge)
RESEND_API_KEY=""
EMAIL_FROM="TG LAB <hola@tglab.cl>"     # el dominio debe estar verificado en Resend
EMAIL_REPLY_TO=""

# --- Rate limiting / caché (opcional: Upstash Redis) --------------------
# Vacío = rate limiting en memoria (suficiente para 1 instancia).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Analítica (opcional) ---------------------------------------------------
# Los scripts sólo se cargan si el ID correspondiente está definido.
# Sin IDs no se inyecta ningún tag de terceros (mejor para privacidad y velocidad).
NEXT_PUBLIC_GA4_ID=""                       # Google Analytics 4, formato G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=""                # Meta (Facebook) Pixel, sólo dígitos
# Eventos de e-commerce que se envían: view_item, add_to_cart, remove_from_cart,
# view_cart, begin_checkout, purchase (purchase se deduplica por pedido).

# --- Monitoreo de errores (opcional: Sentry) --------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Boleta electrónica SII (fase posterior, desacoplado) ------------------
# Interfaz preparada; sin proveedor conectado todavía.
SII_DOCUMENTS_DRIVER="none"                 # none | (proveedor futuro)
